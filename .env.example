# Copiar a .env (no se commitea). MS4 — Manifiesto de Vuelo (sin BD).

PORT=8004
LOG_LEVEL=info
ENV=local

# MS4 agrega llamando a MS1/MS2/MS3 (no tiene base de datos propia)
MS1_BASE_URL=http://localhost:8001
MS2_BASE_URL=http://localhost:8002
MS3_BASE_URL=http://localhost:8003
HTTP_TIMEOUT_SECONDS=3
HTTP_RETRIES=2
